    },
    {
      "page_title": "Consumer Price Index - Year-over-Year Change",
      "series": [
        {
          "id": "CPIAUCSL",
          "label": "CPI-U"
        }
      ],
      "transform": "yoy",
      "frequency": "monthly",
      "units": "Percent",
      "notes": "Year-over-year percent change. Source: Bureau of Labor Statistics via FRED"
    },
    {
      "page_title": "Unemployment Rate",
      "series": [
        {
          "id": "UNRATE",
          "label": "U-3 Unemployment Rate"
        }
      ],
      "transform": "level",
      "frequency": "monthly",
      "units": "Percent",
      "notes": "Seasonally adjusted. Source: Bureau of Labor Statistics via FRED"
    },
    {
      "page_title": "Federal Funds Effective Rate",
      "series": [
        {
          "id": "FEDFUNDS",
          "label": "Federal Funds Rate"
        }
      ],
      "transform": "level",
      "frequency": "monthly",
      "units": "Percent",
      "notes": "Target range midpoint. Source: Federal Reserve via FRED"
    },
    {
      "page_title": "10-Year Treasury Constant Maturity Rate",
      "series": [
        {
          "id": "GS10",
          "label": "10-Year Treasury Yield"
        }
